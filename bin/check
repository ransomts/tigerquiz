#!/usr/bin/env ruby
# frozen_string_literal: true

# Validate every quiz and class list, or the ones named on the command line.
#   bin/check
#   bin/check my-quiz path/to/other.json
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "tigerquiz/quiz_check"

exit Tigerquiz::QuizCheck.new(root: File.expand_path("..", __dir__)).run(ARGV.reject { |a| a.start_with?("-") })
