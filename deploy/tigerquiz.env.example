# /etc/tigerquiz.env  (mode 0600, owned by root)

# Bind to loopback only. Apache proxies to it and sets X-Remote-User from the
# Shibboleth session; if the app were reachable directly, anyone on the network
# could set that header themselves. See deploy/apache-shibboleth.conf.example.
# Leave this unset in Docker, where the container needs 0.0.0.0.
HOST=127.0.0.1
PORT=3000

# Where the report database lives, if not ./data under the checkout.
# TIGERQUIZ_DATA=/srv/tigerquiz-data

# Turn on sign-in and per-instructor ownership. Without this the app reads the
# header but enforces nothing, which is the right default for a classroom
# laptop and the wrong one behind Shibboleth.
TIGERQUIZ_AUTH=required

# The headers Apache sets from the Shibboleth session (defaults shown).
# TIGERQUIZ_USER_HEADER=X-Remote-User
# TIGERQUIZ_NAME_HEADER=X-Remote-Name

# How long a game waits for a host whose browser dropped, in milliseconds.
# HOST_GRACE_MS=180000

# How long the host page's key from /api/host-key stays valid.
# HOST_KEY_TTL_MS=43200000

# Trust X-Forwarded-For, which Apache sets. Needed so the PIN guessing throttle
# can tell clients apart: behind a proxy every socket looks like 127.0.0.1, so
# without this one attacker spends the whole campus's budget. Only ever set it
# when a proxy really is in front, or a client can hand itself a fresh budget.
TIGERQUIZ_TRUST_PROXY=true

# How many wrong PINs a client may try before it has to wait, and how fast that
# budget returns. Only wrong guesses are charged, so a class joining a game
# costs nothing. The defaults turn a sweep of all 900,000 PINs from about four
# minutes into about three months.
# TIGERQUIZ_JOIN_BURST=20
# TIGERQUIZ_JOIN_REFILL_MS=10000

# How many games may be open at once. Each holds its players, their answers and
# a timer in memory until it finishes or the host abandons it.
# MAX_ROOMS=200
