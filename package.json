{
  "name": "tigerquiz",
  "version": "0.1.0",
  "description": "Self-hosted live quiz game (Kahoot-style) for classrooms",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning test/game.test.mjs",
    "test:auth": "node --disable-warning=ExperimentalWarning test/auth.test.mjs",
    "check": "node --disable-warning=ExperimentalWarning tools/check-quizzes.mjs",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "socket.io-client": "^4.8.3",
    "typescript": "^7.0.2"
  }
}
