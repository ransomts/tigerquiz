{
  "name": "tigerquiz",
  "version": "0.1.0",
  "description": "Self-hosted live quiz game (Kahoot-style) for classrooms",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:unit": "node --test test/questions.test.mjs test/ratelimit.test.mjs test/import.test.mjs",
    "test": "node test/game.test.mjs",
    "test:auth": "node test/auth.test.mjs",
    "check": "node tools/check-quizzes.mjs",
    "lint": "eslint .",
    "typecheck": "tsc",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=lib/questions.js --test-coverage-include=lib/ratelimit.js test/questions.test.mjs test/ratelimit.test.mjs"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2"
  }
}
