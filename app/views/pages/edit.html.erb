<% content_for :title, "tigerquiz · editor" %>
<% content_for :body_class, "doc" %>
<main class="doc-main">
  <header class="doc-head">
    <h1>Quiz editor</h1>
    <div class="row">
      <a class="btnlink" href="<%= host_path %>">Host a game</a>
      <a class="btnlink" href="<%= reports_path %>">Reports</a>
    </div>
  </header>

  <!-- list of quizzes and class lists -->
  <section id="listView">
    <div class="doc-head">
      <h2>Quizzes</h2>
      <div class="row">
        <button id="newQuizBtn" class="primary">New quiz</button>
        <button id="importBtn">Import questions</button>
      </div>
    </div>
    <div id="quizList" class="cardlist"></div>

    <div class="doc-head" style="margin-top:2rem">
      <h2>Class lists</h2>
      <button id="newRosterBtn">New class list</button>
    </div>
    <div id="rosterList" class="cardlist"></div>
  </section>

  <!-- quiz editing -->
  <section id="editView" hidden>
    <p><a href="#" id="backLink">← All quizzes</a></p>
    <div class="doc-head">
      <h2 id="editHeading">Edit quiz</h2>
      <div class="row">
        <span id="saveState" class="muted"></span>
        <button id="saveBtn" class="primary">Save</button>
      </div>
    </div>

    <div id="problems" class="callout problems" hidden></div>

    <div class="fieldgrid">
      <label>Title<input id="fTitle" maxlength="80" placeholder="Unit 3 review"></label>
      <label>Short name<input id="fId" maxlength="60" placeholder="unit-3-review"></label>
      <label>Ask players for<input id="fIdentifier" maxlength="40" placeholder="Student ID (optional)"></label>
    </div>
    <div class="row checkrow">
      <label class="check"><input type="checkbox" id="fShuffleQ"> Shuffle question order</label>
      <label class="check"><input type="checkbox" id="fShuffleA"> Shuffle answer order</label>
      <label class="check"><input type="checkbox" id="fPhoneText" checked> Show question text on phones</label>
    </div>

    <div id="questions" class="qlist"></div>

    <div class="row addrow">
      <select id="addType">
        <option value="choice">Multiple choice</option>
        <option value="truefalse">True or false</option>
        <option value="multi">Multiple correct answers</option>
        <option value="slider">Number guess (slider)</option>
        <option value="text">Typed answer</option>
        <option value="order">Put in order</option>
        <option value="poll">Poll (no right answer)</option>
        <option value="wordcloud">Word cloud</option>
        <option value="slide">Content slide</option>
      </select>
      <button id="addBtn">Add question</button>
      <button id="importInlineBtn">Import questions</button>
    </div>
  </section>

  <!-- class list editing -->
  <section id="rosterView" hidden>
    <p><a href="#" id="rosterBack">← All quizzes</a></p>
    <div class="doc-head">
      <h2>Edit class list</h2>
      <div class="row">
        <span id="rosterState" class="muted"></span>
        <button id="rosterSaveBtn" class="primary">Save</button>
      </div>
    </div>
    <div class="fieldgrid">
      <label>Class name<input id="rTitle" maxlength="80" placeholder="Period 3 Biology"></label>
      <label>Short name<input id="rId" maxlength="60" placeholder="period-3"></label>
    </div>
    <p class="muted">One student per line, as <code>Name</code> or <code>Name, id</code>. Students identify themselves with either.</p>
    <textarea id="rStudents" rows="14" placeholder="Ada Lovelace, 1001&#10;Alan Turing, 1002"></textarea>
  </section>
</main>

<!-- import dialog -->
<div id="importModal" class="modal" hidden>
  <div class="modal-box">
    <h2>Import questions</h2>
    <p class="muted">Paste questions in either format. Mark the correct answer with <code>*</code>.</p>
    <div class="row">
      <button id="fmtText" class="tab active">Plain text</button>
      <button id="fmtCsv" class="tab">CSV</button>
    </div>
    <pre id="fmtHelp" class="hint"></pre>
    <textarea id="importText" rows="12" placeholder="Paste here"></textarea>
    <div id="importPreview" class="muted"></div>
    <div class="row">
      <button id="doImport" class="primary">Add questions</button>
      <button id="cancelImport">Cancel</button>
    </div>
  </div>
</div>
<%= content_for :scripts do %>
  <%= javascript_include_tag "api", "edit" %>
<% end %>
