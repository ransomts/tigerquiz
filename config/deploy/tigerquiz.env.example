# /etc/tigerquiz.env  (mode 0600, owned by root)
# Generate with: bin/rails secret
SECRET_KEY_BASE=replace-me
# Where instructors' question images live, if not quizzes/images under the checkout
# TIGERQUIZ_IMAGES=/srv/tigerquiz-images
# The header Apache sets from the Shibboleth session (defaults shown)
# TIGERQUIZ_USER_HEADER=X-Remote-User
# TIGERQUIZ_NAME_HEADER=X-Remote-Name
# How long a game waits for a host whose browser dropped, in milliseconds
# HOST_GRACE_MS=180000
# How many games may be open at once. Each one holds its players, their answers
# and a timer in memory until it finishes or the host abandons it.
# MAX_ROOMS=200
# Set this when the proxy serves the app from a sub-path rather than the root of
# a domain, so every URL the pages build carries the prefix. See
# config/deploy/nginx.conf.example.
# RAILS_RELATIVE_URL_ROOT=/quiz
